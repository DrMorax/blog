---
import { links } from "@/config";
import { Icon } from "astro-icon/components";
import MobileMenu from "./MobileMenu.astro";
import ThemeMenu from "./ThemeMenu.astro";
---

<nav class="card">
    <MobileMenu />
    <a href="/" class="ghost logo link" aria-label="Morax Home">
        <Icon name="logo" width="3.5rem" height="3.5rem" aria-hidden="true" />
    </a>
    <div class="links-wrapper">
        {
            links.nav.map((link) => (
                <a class="ghost link" href={link.href}>
                    /{link.name}
                </a>
            ))
        }
    </div>
    <ThemeMenu />
</nav>

<style>
    nav {
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0 0 0.5rem;
        /* Deprecated margin value. Was used to reveal the banner */
        /*margin: 0 0 35vh;*/
        height: 4.5rem;
        padding: 0 1rem;
        border-radius: 0;
        border-end-end-radius: var(--border-rounded);
        border-end-start-radius: var(--border-rounded);
        border-top: none;
        transition: margin 0.5s;
    }

    .logo {
        height: 1.8rem;
        width: auto;
        color: var(--primary-color);
    }

    .logo svg {
        position: relative;
        bottom: 50%;
    }

    .links-wrapper {
        display: flex;
        justify-content: space-between;
        padding-right: 2.5rem;
        gap: 0.5rem;
    }

    @media (max-width: 56rem) {
        .links-wrapper {
            display: none;
        }

        /* Deprecated value allows the reveal of the banner */
        /*nav {
            margin: 0 0 20rem;
        }*/
    }
</style>
