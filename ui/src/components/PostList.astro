---
import type { CollectionEntry } from "astro:content";
interface Props {
    posts: CollectionEntry<"blog">[];
    tag?: string;
}

const { posts, tag } = Astro.props;
const monthYear = new Intl.DateTimeFormat("en", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
});

const entries = posts
    .map((post) => {
        // Frontmatter accepts both YYYY-MM-DD and single-digit months/days.
        const [year, month, day] = post.data.date.split("-");
        const date = `${year}-${month.padStart(2, "0")}-${day.padStart(2, "0")}`;
        return { post, date };
    })
    .sort((a, b) => b.date.localeCompare(a.date));
---

<section class="post-archive card">
    {tag ? (
        <header class="archive-trail">
            <a href="/posts">All posts</a>
            <span aria-hidden="true">/</span>
            <h1>#{tag}</h1>
        </header>
    ) : (
        <h1 class="archive-sr-only">Posts</h1>
    )}
    {entries.length ? (
        <ul class="archive-list">
            {entries.map(({ post, date }) => (
                <li class="archive-entry">
                    <time datetime={date}>
                        {monthYear.format(new Date(date))}
                    </time>
                    <div>
                        <h2>
                            <a href={`/post/${post.slug}`}>{post.data.title}</a>
                        </h2>
                        {post.data.tags.length > 0 && (
                            <ul class="archive-tags" aria-label="Tags">
                                {post.data.tags.map((name) => (
                                    <li>
                                        <a
                                            href={`/posts/${encodeURIComponent(name)}`}
                                        >
                                            #{name.replaceAll("-", " ")}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                </li>
            ))}
        </ul>
    ) : (
        <p>No published posts yet.</p>
    )}
</section>

<style is:inline>
    .post-archive {
        padding: clamp(1rem, 4vw, 2.5rem);
        overflow-wrap: anywhere;
    }
    .post-archive .archive-trail {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.25rem 0.6rem;
        padding-bottom: 1rem;
    }
    .post-archive .archive-trail h1 {
        font-size: 1.1rem;
    }
    .post-archive .archive-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
    }
    .post-archive :is(h1, h2, ul) {
        margin: 0;
    }
    .post-archive ul {
        list-style: none;
        padding: 0;
    }
    .post-archive .archive-entry {
        display: grid;
        grid-template-columns: 9rem minmax(0, 1fr);
        gap: 1.5rem;
        padding-block: 1.5rem;
    }
    .post-archive .archive-entry:first-child {
        padding-top: 0;
    }
    .post-archive .archive-entry + .archive-entry {
        border-top: 1px solid var(--secondary-background-color);
    }
    .post-archive .archive-entry:last-child {
        padding-bottom: 0;
    }
    .post-archive .archive-trail a,
    .post-archive time {
        color: color-mix(in srgb, var(--color) 40%, var(--muted-color));
        font-size: 0.9rem;
    }
    .post-archive time {
        padding-top: 0.2rem;
        font-weight: 600;
    }
    .post-archive h2 {
        font-size: 1.3rem;
    }
    .post-archive h2:hover {
        color: var(--primary-color);
    }
    .post-archive a {
        color: inherit;
        text-decoration: none;
    }
    .post-archive a:is(:hover, :focus-visible) {
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
    .post-archive p {
        margin: 0.35rem 0 0;
        line-height: 1.5;
    }
    .post-archive .archive-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }
    .post-archive .archive-tags a {
        display: block;
        padding: 0.25rem 0.6rem;
        background: var(--secondary-background-color);
        border-radius: 1rem;
        font-size: 0.85rem;
    }
    @media (max-width: 40rem) {
        .post-archive .archive-entry {
            grid-template-columns: minmax(0, 1fr);
            gap: 0.4rem;
        }
    }
</style>
