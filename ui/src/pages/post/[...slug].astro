---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const normalizeDate = (raw: string) => {
    const [year, month = "01", day = "01"] = raw.split("-");
    return `${year}-${month.padStart(2, "0")}-${day.padStart(2, "0")}`;
};

const { post } = Astro.props;
const rendered = await render(post);
const sections = rendered.headings.filter(({ depth }) => depth === 2 || depth === 3);
const published = normalizeDate(post.data.date);
const updated = post.data.updated_at ? normalizeDate(post.data.updated_at) : undefined;
const dateLabel = new Intl.DateTimeFormat("en", {
    dateStyle: "long",
    timeZone: "UTC",
}).format(new Date(published));

const ogImagePath = `/blog/${post.id}/cover.jpg`;
const siteURL = Astro.site ?? new URL("https://morax.dev");
const postURL = new URL(Astro.url.pathname, siteURL).toString();
const ogImageURL = new URL(ogImagePath, siteURL).toString();

const articleJsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    image: [ogImageURL],
    datePublished: published,
    ...(updated ? { dateModified: updated } : {}),
    author: {
        "@type": "Person",
        name: "Morax",
        url: new URL("/about/", siteURL).toString(),
    },
    publisher: {
        "@type": "Person",
        name: "Morax",
        url: siteURL.toString(),
    },
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": postURL,
    },
    keywords: post.data.tags,
};
---

<Base
    image={ogImagePath}
    title={`${post.data.title} | Morax`}
    description={post.data.description}
    type="article"
    publishedTime={published}
    modifiedTime={updated}
    jsonLd={articleJsonLd}
>
    <article class="post-article card">
        <header class="post-heading">
            <h1>{post.data.title}</h1>
            <p class="post-deck">{post.data.description}</p>
            <div class="post-details">
                <time datetime={published}>{dateLabel}</time>
                {post.data.tags.length > 0 && (
                    <ul aria-label="Post tags">
                        {post.data.tags.map((tag) => (
                            <li><a href={`/posts/${encodeURIComponent(tag)}`}>#{tag.replaceAll("-", " ")}</a></li>
                        ))}
                    </ul>
                )}
            </div>
        </header>
        {sections.length > 0 && (
            <nav class="post-sections" aria-label="Section links">
                <ul>
                    {sections.map(({ slug, text }) => (
                        <li><a href={`#${slug}`}>{text}</a></li>
                    ))}
                </ul>
            </nav>
        )}

        <div class="post-prose">
            <rendered.Content />
        </div>
        <footer class="post-end">
            <a href="/posts"><span aria-hidden="true">← </span>All posts</a>
        </footer>
    </article>
</Base>
