---
import Base from "@/layouts/Base.astro";
---

<Base
    title="Page Not Found | Morax"
    description="The page you're looking for doesn't exist."
    noindex={true}
>
    <div class="card" style="margin-inline: auto;">
        <div style="width: 40%; margin-inline: auto;">
            <h1>What are you looking for?</h1>
            <img
                src="/404.jpg"
                alt="404 image"
                style="width: 100%; border-radius: var(--border-rounded);"
            />
        </div>
    </div>
</Base>
