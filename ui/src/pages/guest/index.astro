---
import Base from "@/layouts/Base.astro";
import { API_URL } from "@/config";
---

<Base>
    <div class="guestbook-wrapper onload-animation">
        <form
            id="guestbook-form"
            class="card"
            action={`${API_URL}/guestbook`}
            method="post"
        >
            <label for="name">Name (optional)</label>
            <input
                type="text"
                name="name"
                id="name"
                minlength="3"
                maxlength="32"
            />

            <label for="message">Message</label>
            <textarea name="message" id="message" required></textarea>

            <button type="submit" class="btn">
                Submit
            </button>
            <p
                id="form-status"
                style="display: none; margin-top: 1rem; font-weight: bold;"
            ></p>
        </form>

        <div
            id="messages-list"
            class="onload-animation"
            style="animation-delay: calc(var(--onload-animation-interval) * 2);"
        >
            <p class="loading">Loading guestbook...</p>
        </div>
    </div>
    <style is:inline>
        .guestbook-wrapper,
        #messages-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .guestbook-wrapper .message h3 {
            color: var(--primary-color);
        }

        .guestbook-wrapper .message p {
            margin-top: 0 !important;
        }

        .guestbook-wrapper input,
        .guestbook-wrapper textarea {
            border: solid 1px;
            background-color: var(--background);
        }
    </style>
</Base>
