---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Feed from "@/components/Feed.astro";

export async function getStaticPaths() {
    const allPosts = (await getCollection("blog")).filter((p) => !p.data.draft);
    const perPage = 5;
    const totalPages = Math.max(1, Math.ceil(allPosts.length / perPage));
    return Array.from({ length: totalPages }, (_, i) => ({
        params: { page: String(i + 1) },
    }));
}

const { page } = Astro.params;
const pageNumber = Number(page) || 1;
const perPage = 5;

const normalizeDate = (raw: string) => {
    const [year, month = "01", day = "01"] = raw.split("-");
    return `${year}-${month.padStart(2, "0")}-${day.padStart(2, "0")}`;
};

const allPosts = (await getCollection("blog")).filter((p) => !p.data.draft);
allPosts.sort((a, b) =>
    normalizeDate(b.data.date).localeCompare(normalizeDate(a.data.date)),
);

const currentPosts = allPosts.slice(
    (pageNumber - 1) * perPage,
    pageNumber * perPage,
);

const processedPosts = currentPosts.map((post) => {
    const len = (post.body ?? "").split(/\s+/).length;
    const time = Math.floor(len / 130);
    return { ...post, wordCount: len, readingTime: time > 0 ? time : 1 };
});
---

<Base
    title={pageNumber === 1
        ? "Morax — Tech Notes & Security Experiments"
        : `Feed Page ${pageNumber} | Morax`}
    description={`Page ${pageNumber} of posts on Morax — tech notes, security experiments, and reviews.`}
    canonical={pageNumber === 1 ? "/" : undefined}
    noindex={pageNumber === 1}
>
    <Feed
        posts={processedPosts}
        heading={pageNumber === 1 ? "Latest posts" : `Latest posts — Page ${pageNumber}`}
    />
</Base>
