---
import Base from "@/layouts/Base.astro";
import Feed from "@/components/Feed.astro";
import { getCollection, type CollectionEntry } from "astro:content";

type BlogEntry = CollectionEntry<"blog">;

const pathSegment = Astro.url.pathname.split("/").filter(Boolean).at(-1);
const currentPage = Number(pathSegment) || 1;

const allPosts: BlogEntry[] = await getCollection("blog");
const published = allPosts.filter((p) => !p.data.draft);
const normalizeDate = (raw: string) => {
    const [year, month = "01", day = "01"] = raw.split("-");
    return `${year}-${month.padStart(2, "0")}-${day.padStart(2, "0")}`;
};
const sorted = published.sort((a, b) =>
    normalizeDate(b.data.date).localeCompare(normalizeDate(a.data.date)),
);

const PAGE_SIZE = 5;
const start = (currentPage - 1) * PAGE_SIZE;
const posts = sorted.slice(start, start + PAGE_SIZE);
// const total = Math.ceil(sorted.length / PAGE_SIZE);

const siteURL = Astro.site ?? new URL("https://morax.dev");
const description =
    "A personal stash of tech notes, security experiments, and things I don't want to forget.";
const websiteJsonLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Morax",
    url: siteURL.toString(),
    description,
};
---

<Base
    title="Morax — Tech Notes & Security Experiments"
    description={description}
    jsonLd={websiteJsonLd}
>
    <Feed posts={posts} />
</Base>
